# Copy to backend/.env (git-ignored). Loaded automatically by Spring (spring.config.import).

# --- Core ---
PORT=8085
# Default: embedded H2 file DB in backend/data/. For PostgreSQL:
# DATABASE_URL=jdbc:postgresql://localhost:5432/tripzee
# DATABASE_USER=tripzee
# DATABASE_PASSWORD=change-me
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8085
# Set to true when served over HTTPS
COOKIE_SECURE=false

# Seeded admin account (change before deploying!)
ADMIN_EMAIL=admin@tripzee.local
ADMIN_PASSWORD=ChangeMe-Admin123

# --- AI (optional) ---
# Any OpenAI-compatible chat-completions API. Leave empty to use the rule-based planner/assistant.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# --- OpenStreetMap services (no keys needed) ---
# Nominatim's usage policy requires an identifying User-Agent with contact details.
OSM_USER_AGENT=Tripzee/0.1 (contact: you@example.com)
NOMINATIM_URL=https://nominatim.openstreetmap.org
OSRM_URL=https://routing.openstreetmap.de
OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter
# false = no outbound map/wiki calls (offline dev)
EXTERNAL_LOOKUPS=true
